#set text(font: "Fira Code", tracking: -0.03em, size: 14.5pt, weight: 400)
// #set text(size: 16pt)
#set page(height: auto, fill: none, margin: 0em)
#set page(margin: (
  bottom: 1.5cm,
  top: 0.1cm
))

#show pagebreak: none

#set text(fill: fg)
#set line(stroke: fg)
#set rect(stroke: fg)
#set square(stroke: fg)
#set ellipse(stroke: fg)
#set circle(stroke: fg)
